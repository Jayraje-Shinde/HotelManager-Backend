// -----------------------------
// Prisma Generator & Datasource
// -----------------------------
generator client {
   provider = "prisma-client-js"
}

datasource db {
   provider = "postgresql"
   url      = env("DATABASE_URL")
}

// -----------------------------
// ENUMS
// -----------------------------
enum MovementType {
   PURCHASE
   SALE
   BREAKAGE
   MANUAL_ADJUSTMENT
   OPEN_BOTTLE
}

enum BillStatus {
   OPEN
   PAID
   CLOSED
   CANCELLED
   CREDIT
}

enum PaymentMethods {
   CASH
   UPI
   CREDITCARD
   DEBITCARD
   BANK_TRANSFER
   CHEQUE
}

enum PurchasePaymentStatus {
   PAID
   CREDIT
   PARTIAL
}

enum TableState {
   VACANT
   OCCUPIED
   BILLED
}

enum SaleMode {
   BOTTLE
   SHOT
}

enum KOTStatus {
   OPEN
   SENT
   SERVED
   CLOSED
   CANCELLED
}

enum OpenBottleStatus {
   OPEN
   FINISHED
   BREAKAGE
   CLOSED
}

// -----------------------------
// ROLES & USERS
// -----------------------------
model Role {
   id          Int     @id @default(autoincrement())
   name        String  @unique
   description String?
   users       User[]
}

model User {
   id            Int      @id @default(autoincrement())
   name          String
   username      String   @unique
   email         String?  @unique
   waitercode    String?  @unique
   password_hash String?
   is_active     Boolean  @default(true)
   created_at    DateTime @default(now())
   role_id       Int?
   role          Role?    @relation(fields: [role_id], references: [id])

   stockMovements   StockMovement[]
   purchases        Purchase[]
   bills            Bill[]
   kots             KOT[]
   auditLogs        Auditlog[]
   dayClosings      DayClosing[]
   purchasePayments PurchasePayment[]
}

// -----------------------------
// CATEGORY & UNITS
// -----------------------------
model Category {
   id        Int     @id @default(autoincrement())
   name      String  @unique
   is_liquor Boolean @default(false)
   items     Item[]
}

model Unit {
   id          Int     @id @default(autoincrement())
   name        String  @unique
   description String?
   items       Item[]
}

// -----------------------------
// ITEMS
// ── NEW: vat_rate added for liquor items
// ── tax_rate kept as-is (used as gst_rate for food)
// -----------------------------
model Item {
   id            Int     @id @default(autoincrement())
   code          String? @unique
   name          String
   category_id   Int
   unit_id       Int
   tax_rate      Float   @default(0)  // GST rate — food items (5, 18, 0)
   vat_rate      Float   @default(0)  // VAT rate — liquor items (10 for Maharashtra FL3)
   selling_price Float
   stock         Float?
   is_available  Boolean @default(true)
   manage_stock  Boolean @default(true)
   is_liquor     Boolean @default(false)

   excise_rate      Int?
   ml_per_unit      Int?
   peg_price_per_ml Float?

   category Category @relation(fields: [category_id], references: [id])
   unit     Unit     @relation(fields: [unit_id], references: [id])

   bill_items         BillItem[]
   purchase_items     PurchaseItem[]
   purchaseBatches    PurchaseBatch[]
   stockMovements     StockMovement[]
   openLiquorBottles  OpenLiquorBottle[]
   kotitems           KOTItem[]
   dayStockSnapshots  DayStockSnapshot[]
   dayLiquorSnapshots DayLiquorSnapshot[]
}

// -----------------------------
// OPEN LIQUOR BOTTLES
// -----------------------------
model OpenLiquorBottle {
   id              Int              @id @default(autoincrement())
   item_id         Int
   ml_remaining    Int
   opened_at       DateTime         @default(now())
   closed_at       DateTime?
   status          OpenBottleStatus @default(OPEN)
   breakage        Boolean          @default(false)
   breakage_reason String?
   batch_id        Int?

   purchaseBatch    PurchaseBatch?    @relation(fields: [batch_id], references: [id])
   item             Item              @relation(fields: [item_id], references: [id])
   liquorShotUsages LiquorShotUsage[]

   @@index([item_id])
}

// -----------------------------
// STOCK MOVEMENT
// -----------------------------
model StockMovement {
   id              Int          @id @default(autoincrement())
   item_id         Int
   change_qty      Float
   reason          String
   movement_type   MovementType
   ref_id          Int?
   created_by      Int?
   created_at      DateTime     @default(now())
   purchaseBatchId Int?

   item          Item           @relation(fields: [item_id], references: [id])
   user          User?          @relation(fields: [created_by], references: [id])
   purchaseBatch PurchaseBatch? @relation(fields: [purchaseBatchId], references: [id])

   @@index([item_id])
   @@index([movement_type])
}

// -----------------------------
// VENDORS & PURCHASES
// -----------------------------
model Vendor {
   id         Int     @id @default(autoincrement())
   name       String
   contact    String?
   license_no String?
   type       String?

   purchases Purchase[]
}

model Purchase {
   id             Int                   @id @default(autoincrement())
   vendor_id      Int
   total_amount   Float
   amount_paid    Float                 @default(0)
   payment_status PurchasePaymentStatus @default(PAID)
   invoice_no     String                @unique
   purchase_date  DateTime
   created_by     Int?

   vendor           Vendor            @relation(fields: [vendor_id], references: [id])
   user             User?             @relation(fields: [created_by], references: [id])
   items            PurchaseItem[]
   purchaseBatches  PurchaseBatch[]
   purchasePayments PurchasePayment[]

   @@index([vendor_id])
   @@index([payment_status])
}

model PurchaseItem {
   id          Int   @id @default(autoincrement())
   purchase_id Int
   item_id     Int
   quantity    Float
   price       Float

   purchase Purchase @relation(fields: [purchase_id], references: [id])
   item     Item     @relation(fields: [item_id], references: [id])
}

model PurchaseBatch {
   id            Int       @id @default(autoincrement())
   item_id       Int
   purchase_id   Int
   qty_total     Float
   qty_remaining Float
   cost_price    Float
   pack_size     Int
   ml_per_bottle Int?
   scheme_qty    Int?      @default(0)
   batch_number  String?
   expiry_date   DateTime?
   is_duty_paid  Boolean   @default(true)
   created_at    DateTime  @default(now())

   item              Item               @relation(fields: [item_id], references: [id])
   purchase          Purchase           @relation(fields: [purchase_id], references: [id])
   billItemBatches   BillItemBatch[]
   stockMovements    StockMovement[]
   openLiquorBottles OpenLiquorBottle[]

   @@index([item_id])
   @@index([purchase_id])
}

model PurchasePayment {
   id          Int            @id @default(autoincrement())
   purchase_id Int
   amount      Float
   method      PaymentMethods @default(CASH)
   note        String?
   reference   String?
   created_at  DateTime       @default(now())
   created_by  Int?

   purchase Purchase @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
   user     User?    @relation(fields: [created_by], references: [id], onDelete: SetNull)

   @@index([purchase_id])
}

// -----------------------------
// CUSTOMERS
// -----------------------------
model Customer {
   id           Int     @id @default(autoincrement())
   name         String
   phone        String?
   address      String?
   credit_limit Float?

   created_at DateTime @default(now())
   bills      Bill[]

   @@index([phone])
}

// -----------------------------
// BILLING
// ── NEW: total_cgst, total_sgst, total_vat added to Bill
// ── NEW: 6 tax fields added to BillItem
// -----------------------------
model Bill {
   id          Int        @id @default(autoincrement())
   table_no    String
   user_id     Int?
   customer_id Int?
   total       Float      @default(0)
   discount    Float      @default(0)
   total_cgst  Float      @default(0)  // running sum of cgst_amount across all items
   total_sgst  Float      @default(0)  // running sum of sgst_amount across all items
   total_vat   Float      @default(0)  // running sum of vat_amount across all items
   bill_date   DateTime   @default(now())
   status      BillStatus @default(OPEN)

   user          User?         @relation(fields: [user_id], references: [id])
   customer      Customer?     @relation(fields: [customer_id], references: [id])
   items         BillItem[]
   payments      Payment[]
   kots          KOT[]
   tableStatuses TableStatus[]

   @@index([status])
   @@index([customer_id])
}

model BillItem {
   id          Int       @id @default(autoincrement())
   bill_id     Int
   item_id     Int
   quantity    Float
   rate        Float
   subtotal    Float
   sale_mode   SaleMode?
   ml_per_shot Int?

   // Tax snapshot — calculated at KOT close, extracted from inclusive price
   cgst_rate   Float @default(0)  // e.g. 2.5  (half of 5% GST)
   sgst_rate   Float @default(0)  // e.g. 2.5  (half of 5% GST)
   cgst_amount Float @default(0)  // e.g. 7.62 extracted from ₹320 Chicken Tikka
   sgst_amount Float @default(0)  // e.g. 7.62
   vat_rate    Float @default(0)  // e.g. 10   (Maharashtra liquor VAT)
   vat_amount  Float @default(0)  // e.g. 59.09 extracted from ₹650 Royal Stag

   bill Bill @relation(fields: [bill_id], references: [id])
   item Item @relation(fields: [item_id], references: [id])

   batches   BillItemBatch[]
   shotUsage LiquorShotUsage[]
}

model BillItemBatch {
   id                Int      @id @default(autoincrement())
   bill_item_id      Int
   purchase_batch_id Int
   qty_used          Float
   ml_used           Int?
   cost_price_at_use Float
   created_at        DateTime @default(now())

   billItem      BillItem      @relation(fields: [bill_item_id], references: [id])
   purchaseBatch PurchaseBatch @relation(fields: [purchase_batch_id], references: [id])

   @@index([bill_item_id])
   @@index([purchase_batch_id])
}

model LiquorShotUsage {
   id             Int      @id @default(autoincrement())
   bill_item_id   Int?
   open_bottle_id Int
   ml_used        Int
   used_at        DateTime @default(now())
   kot_id         Int?

   billItem   BillItem?        @relation(fields: [bill_item_id], references: [id])
   openBottle OpenLiquorBottle @relation(fields: [open_bottle_id], references: [id])
   kot        KOT?             @relation(fields: [kot_id], references: [id])

   @@index([bill_item_id])
   @@index([open_bottle_id])
}

model Payment {
   id          Int            @id @default(autoincrement())
   billId      Int
   method      PaymentMethods @default(CASH)
   amount      Float
   referenceNo String?
   note        String?
   created_at  DateTime       @default(now())

   bill Bill @relation(fields: [billId], references: [id])

   @@index([billId])
}

// -----------------------------
// TABLE & KOT
// -----------------------------
model TableStatus {
   id              Int        @id @default(autoincrement())
   table_no        String     @unique
   zone            String
   status          TableState @default(VACANT)
   current_bill_id Int?

   bill Bill? @relation(fields: [current_bill_id], references: [id])

   @@index([status])
   @@index([zone])
}

model KOT {
   id         Int       @id @default(autoincrement())
   table_no   String
   waiter_id  Int?
   bill_id    Int?
   kot_no     String
   status     KOTStatus @default(OPEN)
   created_at DateTime  @default(now())
   updated_at DateTime  @default(now())

   waiter           User?             @relation(fields: [waiter_id], references: [id])
   bill             Bill?             @relation(fields: [bill_id], references: [id])
   items            KOTItem[]
   liquorShotUsages LiquorShotUsage[]
}

model KOTItem {
   id          Int       @id @default(autoincrement())
   kot_id      Int
   item_id     Int
   quantity    Float
   sale_mode   SaleMode?
   ml_per_shot Int?
   note        String?

   kot  KOT  @relation(fields: [kot_id], references: [id])
   item Item @relation(fields: [item_id], references: [id])
}

// -----------------------------
// AUDIT
// -----------------------------
model Auditlog {
   id           Int      @id @default(autoincrement())
   user_id      Int?
   action       String
   description  String?
   ip           String?
   created_at   DateTime @default(now())
   dayClosingId Int?

   user       User?       @relation(fields: [user_id], references: [id])
   dayClosing DayClosing? @relation(fields: [dayClosingId], references: [id])

   @@index([user_id])
   @@index([action])
   @@index([created_at])
}

// -----------------------------
// DAY-END SNAPSHOTS
// -----------------------------
model DayClosing {
   id                Int       @id @default(autoincrement())
   business_date     DateTime  @unique
   closed_by         Int
   closed_at         DateTime  @default(now())
   status            String    @default("CLOSED")
   note              String?
   total_sales       Float     @default(0)
   total_payments    Float     @default(0)
   total_stock_value Float     @default(0)
   open_kots_count   Int       @default(0)
   created_at        DateTime  @default(now())
   reopen_allowed    Boolean   @default(false)
   reopen_by         Int?
   reopen_at         DateTime?

   user             User?                @relation(fields: [closed_by], references: [id])
   auditLogs        Auditlog[]
   salesSnapshots   DaySalesSnapshot[]
   stockSnapshots   DayStockSnapshot[]
   paymentSnapshots DayPaymentSnapshot[]
   liquorSnapshots  DayLiquorSnapshot[]
   kotSnapshots     DayKOTSnapshot[]

   @@index([business_date])
}

model DaySalesSnapshot {
   id             Int        @id @default(autoincrement())
   day_closing_id Int
   bill_id        Int
   bill_no        String
   bill_date      DateTime
   user_id        Int?
   table_no       String?
   total          Float
   discount       Float
   status         BillStatus
   created_at     DateTime   @default(now())

   dayClosing DayClosing @relation(fields: [day_closing_id], references: [id])
}

model DayPaymentSnapshot {
   id             Int            @id @default(autoincrement())
   day_closing_id Int
   bill_id        Int
   method         PaymentMethods
   amount         Float
   referenceNo    String?
   created_at     DateTime       @default(now())

   dayClosing DayClosing @relation(fields: [day_closing_id], references: [id])
}

model DayStockSnapshot {
   id             Int      @id @default(autoincrement())
   day_closing_id Int
   item_id        Int
   stock_snapshot Float
   total_value    Float
   created_at     DateTime @default(now())

   dayClosing DayClosing @relation(fields: [day_closing_id], references: [id])
   item       Item       @relation(fields: [item_id], references: [id])

   @@index([item_id])
}

model DayLiquorSnapshot {
   id                Int      @id @default(autoincrement())
   day_closing_id    Int
   item_id           Int
   opening_bottles   Float
   purchased_bottles Float
   broken_bottles    Float
   sealed_sold       Float
   shots_ml_sold     Float
   open_bottles_ml   Float
   theoretical_ml    Float
   variance_ml       Float
   created_at        DateTime @default(now())

   dayClosing DayClosing @relation(fields: [day_closing_id], references: [id])
   item       Item       @relation(fields: [item_id], references: [id])

   @@index([item_id])
}

model DayKOTSnapshot {
   id             Int       @id @default(autoincrement())
   day_closing_id Int
   kot_id         Int
   waiter_id      Int?
   table_no       String
   status         KOTStatus
   created_at     DateTime  @default(now())

   dayClosing DayClosing @relation(fields: [day_closing_id], references: [id])
}
