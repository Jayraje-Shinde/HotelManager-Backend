// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
      provider = "prisma-client-js"
}

datasource db {
      provider = "postgresql"
      url      = env("DATABASE_URL")
}

model Role {
      id          Int     @id @default(autoincrement())
      role_name   String  @unique
      description String?
      users       User[]
}

model User {
      id             Int             @id @default(autoincrement())
      name           String
      email          String?         @unique
      password_hash  String?
      is_active      Boolean         @default(true)
      created_at     DateTime        @default(now())
      role_id        Int?
      role           Role?           @relation(fields: [role_id], references: [id])
      stockMovements StockMovement[]
      purchases      Purchase[]
}

model Category {
      id        Int     @id @default(autoincrement())
      name      String  @unique
      is_liquor Boolean @default(false)
      items     Item[]
}

model Unit {
      id          Int     @id @default(autoincrement())
      name        String  @unique
      description String?
      items       Item[]
}

model Item {
      id             Int     @id @default(autoincrement())
      name           String
      category_id    Int
      unit_id        Int
      selling_price  Float
      purchase_price Float
      tax_rate       Float?
      stock          Float   @default(0)
      is_available   Boolean @default(true)
      duty_per_unit  Float? // used only for liquor items

      category Category @relation(fields: [category_id], references: [id])
      unit     Unit     @relation(fields: [unit_id], references: [id])

      created_at     DateTime        @default(now())
      updated_at     DateTime        @updatedAt
      stockMovements StockMovement[]
      purchaseItems  PurchaseItem[]
}

model StockMovement {
      id         Int      @id @default(autoincrement())
      item_id    Int
      change_qty Float
      reason     String
      ref_type   String? // e.g. 'purchase', 'sale', 'manual', 'wastage'
      ref_id     Int? // links to sale_id, purchase_id, etc.
      created_by Int? // user who triggered it
      created_at DateTime @default(now())

      item Item  @relation(fields: [item_id], references: [id])
      user User? @relation(fields: [created_by], references: [id])
}

model Purchase {
      id            Int      @id @default(autoincrement())
      vendor_id     Int
      total_amount  Float
      invoice_no    String   @unique
      purchase_date DateTime
      created_by    Int?

      vendor Vendor         @relation(fields: [vendor_id], references: [id])
      items  PurchaseItem[]

      user User? @relation(fields: [created_by], references: [id])
}

model PurchaseItem {
      id          Int   @id @default(autoincrement())
      purchase_id Int
      item_id     Int
      quantity    Float
      price       Float

      purchase Purchase @relation(fields: [purchase_id], references: [id])
      item     Item     @relation(fields: [item_id], references: [id])
}

model Vendor {
      id         Int     @id @default(autoincrement())
      name       String
      contact    String?
      license_no String?
      type       String? // e.g. "liquor", "grocery", "general"

      purchases Purchase[]
}
